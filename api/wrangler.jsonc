{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-basket-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret configuration. Secrets (ANTHROPIC_API_KEY, APP_KEY) live in .dev.vars locally and
  // `wrangler secret put` in production — never here.
  "vars": {
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "DAILY_LIMIT": "30",
    "FREE_SCANS": "7",          // the trial, for the life of the device — must match ScanAllowance.trialScans
    "WEEKLY_SCANS": "25",       // the subscription's ceiling — must match ScanAllowance.weeklyScans, and is never shown
    "WEEKLY_WINDOW_DAYS": "7",
    "MAX_BODY_BYTES": "8388608",
    // Every purchase in development and TestFlight is a Sandbox transaction, so this has to be true to
    // test at all. **Set it to "false" before public release** — a sandbox account is otherwise a free
    // subscription. Tracked as a release blocker in docs/APPSTORE.md.
    "ALLOW_SANDBOX_ENTITLEMENTS": "true"
  },
  // Per-device daily extraction counter (SPEC §9). Replace the id with `wrangler kv namespace create QUOTA` on deploy.
  "kv_namespaces": [{ "binding": "QUOTA", "id": "a99437ed2a2940b8839ac8a803141076" }]
}
