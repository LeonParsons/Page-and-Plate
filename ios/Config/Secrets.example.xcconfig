// Copy to Secrets.xcconfig (git-ignored) and fill in. Values land in Info.plist as RBAPIBaseURL / RBAppKey.
// `$()` keeps the `//` in the URL from being read as a comment.
// Simulator: http:/$()/localhost:8787 with `npm run dev`. Device: your deployed Worker, e.g. https:/$()/recipe-basket-api.<you>.workers.dev
RB_API_BASE_URL = http:/$()/localhost:8787
RB_APP_KEY = change-me
// Apple Developer team id, needed only to run on a physical device (Xcode → Settings → Accounts).
RB_TEAM_ID =
